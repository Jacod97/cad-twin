    def "Lights"
    {
        def DomeLight "Dome"
        {
            float inputs:intensity = 700
        }

        def DistantLight "Sun"
        {
            float inputs:angle = 1.5
            float inputs:intensity = 2500
            float3 xformOp:rotateXYZ = (40, 0, 30)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }
}

